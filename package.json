{
  "name": "pr-guard",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "10.0.3"
  }
}
